# Banco Supabase/PostgreSQL. Não comite credenciais reais.
SPRING_DATASOURCE_URL=jdbc:postgresql://HOST:PORT/postgres?sslmode=require
SPRING_DATASOURCE_USERNAME=USUARIO_BANCO
SPRING_DATASOURCE_PASSWORD=SENHA_DO_USUARIO_DO_BANCO

# Gere uma chave local com: openssl rand -base64 32
JWT_SECRET_BASE64=SUBSTITUA_POR_UMA_CHAVE_BASE64_DE_PELO_MENOS_32_BYTES
JWT_EXPIRATION_MINUTES=60
CORS_ALLOWED_ORIGINS=http://localhost:3000
SERVER_PORT=8080
